export LESS_TERMCAP_me=$'\e[0m' LESS_TERMCAP_ue=$'\e[0m' LESS_TERMCAP_se=$'\e[0m'
export GROFF_NO_SGR=1
export MANPAGER='less -R'

# drill can move you to an exercise's starting folder; a program can't change its
# parent shell's directory, so this wrapper does it after drill exits.
drill() {
    command drill "$@"
    local rc=$?
    local f="/tmp/drill-cd-$UID"
    if [ -f "$f" ]; then
        cd "$(cat "$f")" || true
        rm -f "$f"
    fi
    return $rc
}

if [ -z "$LEARN_LINUX_MOTD_SHOWN" ]; then
    export LEARN_LINUX_MOTD_SHOWN=1
    printf '%b' "$(< /etc/learn-linux/motd)"
    echo
fi
